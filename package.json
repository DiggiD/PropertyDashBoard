{
  "name": "sankey-property-dashboard",
  "version": "1.0.0",
  "description": "Interactive Property Expense Dashboard with Sankey Charts",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:babel": "babel src --out-dir dist-cjs",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "NODE_ENV=test jest",
    "clear_jest": "jest --clearCache",
    "test:unit": "jest --no-coverage --reporters=default",
    "test:coverage": "jest --coverage --no-cache --runInBand",
    "test:pass": "jest --reporters=default --no-coverage",
    "test:fix": "jest --clearCache && npm run test:coverage",
    "test:verify": "node -e \"console.log('Run npm run test:coverage first')\"",
    "test:debug": "jest --verbose --runInBand --detectOpenHandles",
    "test:sankey": "jest src/modules/core/__tests__/sankey-*.test.js",
    "test:watch": "jest --watch",
    "test:changed": "jest --watch --onlyChanged --watchAll=false",
    "test:utils": "jest src/__tests__/utils.test.js",
    "test:formatter": "jest src/__tests__/Formatter.test.js",
    "test:validator": "jest src/__tests__/Validator.test.js",
    "test:storage": "jest src/__tests__/Storage.test.js",
    "test:performance": "jest src/__tests__/PerformanceOptimizer.test.js",
    "test:utils:fast": "jest src/__tests__/Formatter.test.js src/__tests__/Validator.test.js src/__tests__/Storage.test.js src/__tests__/PerformanceOptimizer.test.js --runInBand",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src index.html style.css",
    "format:check": "prettier --check src index.html style.css"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.28.4",
    "@eslint/js": "^9.9.0",
    "@testing-library/jest-dom": "^6.8.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2",
    "vite": "^5.0.0"
  },
  "keywords": [
    "dashboard",
    "expenses",
    "property",
    "visualization",
    "d3js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "dexie": "^4.2.0",
    "node-fetch": "^3.3.2"
  }
}
